# Local development defaults. Copy to .env to override.
# Docker services read these; app services read their own .env files.

# Postgres
POSTGRES_USER=ugc
POSTGRES_PASSWORD=ugc
POSTGRES_DB=ugc
DATABASE_URL=postgresql+psycopg://ugc:ugc@localhost:5432/ugc

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=ugc
MINIO_ROOT_PASSWORD=ugcsecret
MINIO_BUCKET=ugc-assets

# App
API_PORT=8000
